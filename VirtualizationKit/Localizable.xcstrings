{
  "sourceLanguage" : "en",
  "strings" : {
    "error-applevz-limitexceeded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to limitations imposed by Apple, it is only possible to run two macOS Virtual Machines at the same time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa di una limitazione imposta da Apple, non è possibile avviare più di due Macchine Virtuali macOS in contemporanea."
          }
        }
      }
    },
    "error-configuration-auxstorage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not create macOS auxiliary storage file"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile create il file di memorizzazione ausiliario per macOS"
          }
        }
      }
    },
    "error-configuration-capturedevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The virtual machine has been configured with a capture device, but the application does not have permission to use it"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macchina virtuale è stata configurata con un dispositivo di cattura, ma l’applicazione non ha il permesso di usarlo."
          }
        }
      }
    },
