        }
      }
    },
    "error-missingMacImage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The macOS installation image could not be found"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile trovare l'immagine di ripristino di macOS "
          }
        }
      }
    },
    "error-permissionDenied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following feature cannot be accessed on the %@ machine or operating system because permission has been denied: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è possibile accedere alla seguente funzionalità della macchina o del sistema operativo %@ a causa di mancanza di autorizzazione: “%@”"
          }
        }
      }
    },
    "error-unavailableFeature" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following feature is supported but not available on the %@ machine or operating system: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguente funzionalità è supportata ma non disponibile sulla macchina o sistema operativo %@: “%@”"
