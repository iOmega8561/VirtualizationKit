    "error-appleLimitExceeded" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to limitations imposed by Apple’s license agreement, it is only possible to run a fixed amount of macOS Virtual Machines at the same time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa di una limitazione prevista dagli accordi di licenza di Apple, non è possibile avviare più di un certo numero di Macchine Virtuali macOS in contemporanea."
          }
        }
      }
    },
    "error-auxiliaryFailedSetup" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not create macOS auxiliary storage file"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile create il file di memorizzazione ausiliario per macOS"
          }
        }
      }
    },
    "error-bridgeNicUnavailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following network interface is not available on the host system: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguente interfaccia di rete non è disponibile sul sistema host: “%@”"
          }
        }
      }
    },
    "error-bridgeNoNicsAvailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn’t any available network interface to setup Bridged networking"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esistono interfacce di rete disponibili per costruire una rete Bridged"
          }
        }
      }
    },
    "error-coreFilesMissing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critical Virtual Machine files are missing or have been deleted. Please delete or recreate the Virtual Machine"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File critici per il funzionamento della Macchina Virtuale sono mancanti o sono stati eliminati. Si prega di eliminare o ricreare la Macchina Virtuale."
          }
        }
      }
    },
    "error-coreFilesTampered" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Critical Virtual Machine files are corrupted or have been tampered with. Please delete or recreate the Virtual Machine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File critici per il funzionamento della Macchina Virtuale sono stati corrotti o manomessi. Si prega di eliminare o ricreare la Macchina Virtuale"
          }
        }
      }
    },
    "error-diskImageFailedSetup" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not create device attachment for main disk"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile creare il dispositivo a blocchi per il disco principale"
          }
        }
      }
    },
    "error-invalidMacAddress" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The specified MAC Address is not valid: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il MAC Address specificato non è valido: “%@”"
          }
