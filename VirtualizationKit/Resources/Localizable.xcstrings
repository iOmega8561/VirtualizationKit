{
  "sourceLanguage" : "en",
  "strings" : {
    "error-appleLimitExceeded" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due to limitations imposed by Apple, it is only possible to run %d macOS Virtual Machines at the same time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A causa di una limitazione imposta da Apple, non è possibile avviare più di %d Macchine Virtuali macOS in contemporanea."
          }
        }
      }
    },
    "error-auxiliaryFailedSetup" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not create macOS auxiliary storage file"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile create il file di memorizzazione ausiliario per macOS"
          }
        }
      }
    },
    "error-bridgeNicUnavailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following network interface is not available on the host system: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguente interfaccia di rete non è disponibile sul sistema host: “%@”"
          }
        }
      }
    },
    "error-bridgeNoNicsAvailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There isn’t any available network interface to setup Bridged networking"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esistono interfacce di rete disponibili per costruire una rete Bridged"
          }
        }
      }
    },
    "error-captureDevicePermissionDenied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The virtual machine has been configured with a capture device, but the application does not have permission to use it"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La macchina virtuale è stata configurata con un dispositivo di cattura, ma l’applicazione non ha il permesso di usarlo."
          }
        }
      }
    },
    "error-diskImageFailedSetup" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not create device attachment for main disk"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile creare il dispositivo a blocchi per il disco principale"
          }
        }
      }
    },
    "error-invalidMacAddress" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The specified MAC Address is not valid: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il MAC Address specificato non è valido: “%@”"
          }
        }
      }
    },
    "error-machineIdCorrupt" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Unique Identifier of the Virtual Machine appears to be corrupt. Please re-create this Virtual Machine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’Identificativo Univoco della Macchina Virtuale sembra corrotto. Per favore ricreare la Macchina. "
          }
        }
      }
    },
    "error-machineIdMissing" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Unique Identifier file of the Virtual Machine could not be found (could have been deleted). Please re-create this Virtual Machine"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile trovare il file contenente l’Identificativo Univoco della Macchina Virtuale (potrebbe essere stato rimosso). Per favore ricreare la Macchina."
          }
        }
      }
    },
    "error-macUnsupportedHost" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This mac is not supported by the chosen macOS restore image"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo mac non è supportato dall'immagine di ripristino di macOS scelta"
          }
        }
      }
    },
    "error-macUnsupportedImage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chosen macOS restore image does not support any feasible configuration"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine di ripristino di macOS scelta non supporta alcuna configurazione possibile"
          }
        }
      }
    },
    "error-missingMacImage" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The macOS installation image could not be found"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile trovare l'immagine di ripristino di macOS "
          }
        }
      }
    },
    "error-rosettaUnavailable" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta is unavailable on the host Macintosh"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta non è disponibile sul Macintosh Host"
          }
        }
      }
    },
    "error-unsupportedFeature" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following feature is not supported by the %@ machine or operating system: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La seguente funzionalità non è supportata dalla macchina o sistema operativo %@: “%@”"
          }
        }
      }
    },
    "error-usbDeviceNotFound" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The para-virtualized USB device with the following identifier does not exist: “%@”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo USB para-virtualizzato con il seguente identificativo non esiste: “%@”"
          }
        }
      }
    },
    "error-wrongMacImageVersion" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Virtual Machine has been created using a  macOS %@ restore image, but the currently selected image’s version is %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Macchina Virtuale è stata creata utilizzando un’immagine di ripristino di macOS %@, ma la versione dell’immagine attualmente selezionata è %@"
          }
        }
      }
    },
